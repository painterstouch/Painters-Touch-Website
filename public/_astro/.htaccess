# Files in /_astro/ get a new name every time they change, so browsers can keep them for a year.
# Written as a FilesMatch block so it is applied after (and overrides) the 30-day rule in the site's root .htaccess.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|avif|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
