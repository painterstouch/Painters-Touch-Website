---
import { breadcrumbSchema } from '../lib/schema';
import { jsonLd } from '../lib/utils';

interface Props {
  /** Trail after "Home", e.g. [{ name: 'Services', href: '/services/' }, { name: 'Interior painting', href: '/services/interior-painting/' }] */
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const trail = [{ name: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      trail.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-ink/40">/</span>}
          {i === trail.length - 1 ? (
            <span aria-current="page" class="font-semibold text-ink">{item.name}</span>
          ) : (
            <a href={item.href} class="hit inline-block underline decoration-ink/30 hover:decoration-ink">{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={jsonLd(breadcrumbSchema(trail))} />
