---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { phoneHref } from '../lib/utils';

// Optional hero photo: drop a file named hero.jpg (or .png/.webp) into src/assets and it replaces the paint chips.
const heroFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.{jpg,jpeg,png,webp,avif}', { eager: true });
const heroPhoto = Object.values(heroFiles)[0]?.default;

// Chips fan out from the center. `side` decides which edge the label sits on so it isn't hidden by its neighbor.
const chips = [
  { name: 'Park Sage', sheen: 'Matte', hex: '#A3AD99', r: -34, side: 'left' },
  { name: 'Stoop Gray', sheen: 'Flat', hex: '#B8AFA3', r: -17, side: 'left' },
  { name: 'Hudson Fog', sheen: 'Eggshell', hex: '#98A19B', r: 0, side: 'center' },
  { name: 'Bordeaux', sheen: 'Satin', hex: site.brand.accent, r: 17, side: 'right' },
  { name: 'Fire Escape', sheen: 'Semi-gloss', hex: '#2B2A2B', r: 34, side: 'right' },
];
---

<section class="overflow-hidden">
  <div class="wrap grid items-center gap-8 pt-8 pb-10 sm:gap-12 sm:pt-14 sm:pb-20 lg:grid-cols-12 lg:gap-6 lg:pt-16 lg:pb-24">
    <div class="lg:col-span-7">
      <h1>Interior painters for NYC apartments, homes and offices</h1>
      <p class="lead mt-5 sm:mt-6">
        Flat-rate quotes, crews that arrive on time, and a finish that looks incredible. We protect your furniture and
        floors on every job.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row">
        <a href="/contact/" class="btn btn-primary">Get a Free Quote</a>
        {/* On phones the Call button lives in the sticky bar at the bottom, so it isn't repeated here. */}
        <a href={phoneHref()} class="btn btn-outline max-sm:hidden">
          <Icon name="phone" size={20} />
          Call Now
          <span class="sr-only">{site.phone}</span>
        </a>
      </div>
      <p class="mt-5 text-sm text-ink-soft sm:mt-6">Painting in {site.areaSummary}.</p>
    </div>

    <div class="lg:col-span-5">
      {
        heroPhoto ? (
          <Picture
            src={heroPhoto}
            alt={`Freshly painted interior by ${site.name}`}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 480px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full rounded-[2px] object-cover"
            pictureAttributes={{ class: 'contents' }}
          />
        ) : (
          <div class="fan" aria-hidden="true">
            {chips.map((c, i) => (
              <div
                class="fan-chip"
                data-side={c.side}
                style={`--c:${c.hex};--r:${c.r};--i:${i};--z:${5 - Math.abs(i - 2)}`}
              >
                <div class="fan-label">
                  <span class="fan-name">{c.name}</span>
                  <span class="fan-sheen">{c.sheen}</span>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .fan {
    --k: 0.68; /* narrower fan on phones so no chip is cut off */
    --w: 32%;
    --h: 80%;
    position: relative;
    width: min(84%, 20rem); /* a compact fan on phones, so it doesn't push the real content off the screen */
    aspect-ratio: 1 / 0.9;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .fan {
      --k: 1;
      --w: 36%;
      --h: 90%;
      width: min(100%, 26rem);
      aspect-ratio: 1 / 1.08;
    }
  }
  .fan-chip {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--w);
    height: var(--h);
    margin-left: calc(var(--w) / -2);
    z-index: var(--z);
    border-radius: 5px;
    background: var(--c);
    box-shadow: 0 0 0 1px rgb(23 23 25 / 0.12);
    transform-origin: 50% 94%;
    transform: rotate(calc(var(--r) * var(--k) * 1deg));
    animation: fan-out 1.15s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--i) * 70ms);
  }
  .fan-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.6rem 0.6rem;
    border-radius: 5px 5px 0 0;
    background: #fff;
    color: var(--color-ink);
    line-height: 1.15;
  }
  .fan-chip[data-side='left'] .fan-label {
    text-align: left;
  }
  .fan-chip[data-side='right'] .fan-label {
    text-align: right;
  }
  .fan-chip[data-side='center'] .fan-label {
    text-align: center;
  }
  /* On phones the chips overlap too much for every label, so only the center chip is labelled. */
  @media (max-width: 639px) {
    .fan-chip:not([data-side='center']) .fan-label > span {
      display: none;
    }
    .fan-chip:not([data-side='center']) .fan-label {
      height: 1.4rem;
      padding: 0;
    }
  }
  .fan-name {
    font-size: clamp(0.62rem, 1.9vw, 0.8rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .fan-sheen {
    font-size: clamp(0.58rem, 1.6vw, 0.7rem);
    color: var(--color-ink-soft);
  }
</style>
