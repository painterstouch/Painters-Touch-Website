---
import { Picture } from 'astro:assets';
import type { Project } from '../lib/data';

interface Props {
  project: Project;
  sizes?: string;
  eager?: boolean;
}
// Phones and tablets show two cards per row, so each image is about half the screen wide.
const { project, sizes = '(min-width: 1024px) 352px, 50vw', eager = false } = Astro.props;
const { title, location, roomType, after, afterAlt, before, sample, gallery } = project.data;
// Projects with more than one photo say so, so visitors know there is more to see.
const photoCount = (before ? 2 : 1) + gallery.length;
---

<a href={`/work/${project.id}/`} class="group block no-underline">
  <div class="relative overflow-hidden rounded-[2px] bg-stoop">
    <Picture
      src={after}
      alt={afterAlt ?? `${title}, finished ${roomType.toLowerCase()} painting project in ${location}`}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 960]}
      {sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
      pictureAttributes={{ class: 'contents' }}
    />
    {
      before && (
        <span class="absolute top-2 left-2 rounded-[2px] bg-white px-2 py-1 text-[0.8125rem] leading-none font-bold text-ink sm:top-3 sm:left-3">Before and after</span>
      )
    }
    {
      !before && photoCount > 1 && (
        <span class="absolute bottom-2 left-2 rounded-[2px] bg-ink/90 px-2 py-1 text-[0.8125rem] leading-none font-bold text-white sm:bottom-3 sm:left-3">{photoCount} photos</span>
      )
    }
    {sample && <span class="absolute top-3 right-3 rounded-[2px] bg-ink px-2 py-1 text-[0.8125rem] font-bold text-white">Sample project</span>}
  </div>
  <div class="mt-2.5 flex items-start justify-between gap-3 sm:mt-3">
    <div>
      <h3 class="text-[0.95rem] leading-snug group-hover:underline decoration-2 underline-offset-4 sm:text-lg sm:leading-[1.15]">{title}</h3>
      <p class="mt-1 text-[0.8125rem] text-ink-soft sm:text-sm">{location}</p>
    </div>
    {/* The category label is left out on phones: the cards are small and the filters above already name the category. */}
    <span class="mt-0.5 hidden flex-none rounded-[2px] border border-ink/25 px-2 py-0.5 text-[0.8125rem] font-semibold text-ink-soft sm:block">{roomType}</span>
  </div>
</a>
