---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { getPosts, getServices } from '../../lib/data';
import { AUTHOR_URL, blogPostingSchema, faqSchema, personSchema } from '../../lib/schema';
import { authorBio, pageTitle } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
// Table of contents: every H2 in the post, with jump links (long posts only).
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const [services, allPosts] = await Promise.all([getServices(), getPosts()]);
const service = services.find((s) => s.id === data.service);
const morePosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const url = `/blog/${post.id}/`;
// A 1200 x 630 JPEG of the main photo for link previews (Facebook, iMessage, Google).
const og = await getImage({ src: data.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
// Twitter/X cards use a 1200 x 600 version.
const tw = await getImage({ src: data.hero, width: 1200, height: 600, fit: 'cover', format: 'jpg' });
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const schema: object[] = [
  blogPostingSchema({
    url,
    title: data.title,
    description: data.metaDescription,
    image: og.src,
    datePublished: data.date,
    dateModified: data.updated,
  }),
];
schema.push(personSchema());
if (data.faqs.length) schema.push(faqSchema(data.faqs));
---

<BaseLayout
  title={pageTitle(data.metaTitle)}
  description={data.metaDescription}
  ogDescription={data.excerpt}
  ogType="article"
  ogImage={og.src}
  twitterImage={tw.src}
  {schema}
>
  <article>
    <header id="top" class="page-head border-b border-line pt-6 pb-8 sm:pt-10 sm:pb-12">
      <div class="wrap">
        <Breadcrumbs
          items={[
            { name: 'Blog', href: '/blog/' },
            { name: data.title, href: url },
          ]}
        />
        <h1 class="mt-4 max-w-4xl sm:mt-6">{data.title}</h1>
        <p class="lead mt-4 sm:mt-5">{data.excerpt}</p>
        <p class="mt-5 text-sm text-ink-soft">
          By <a href={AUTHOR_URL} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">{site.author.name}</a>,{' '}
          {site.author.role.toLowerCase()} of {site.name} ·{' '}
          <time datetime={iso(data.date)}>{dateFmt(data.date)}</time>
          {
            data.updated && (
              <>
                {' '}· Updated <time datetime={iso(data.updated)}>{dateFmt(data.updated)}</time>
              </>
            )
          }
        </p>
      </div>
    </header>

    <div class="wrap pt-8 sm:pt-10">
      <figure class="max-w-5xl">
        <Picture
          src={data.hero}
          alt={data.heroAlt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1100px) 1024px, 100vw"
          class="aspect-[16/10] w-full rounded-[2px] object-cover"
          loading="eager"
          fetchpriority="high"
        />
        {data.heroCredit && <figcaption class="mt-2 text-sm text-ink-soft">{data.heroCredit}</figcaption>}
      </figure>
    </div>

    <section class="section pt-10 sm:pt-12">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="min-w-0 lg:col-span-8">
          {
            showToc && (
              <nav aria-labelledby="toc-heading" class="mb-10 max-w-[40rem] border border-line bg-white p-5 sm:p-6">
                <p id="toc-heading" class="font-bold">On this page</p>
                <ol class="mt-3 list-decimal space-y-1 pl-5">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="inline-block py-1 underline decoration-ink/30 underline-offset-4 hover:decoration-ink">{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="prose-site prose-post">
            <Content />
          </div>

          <aside aria-labelledby="author-heading" class="mt-12 max-w-[40rem] border-t border-line pt-8">
            <p id="author-heading" class="text-sm font-bold uppercase tracking-wide text-ink-soft">About the author</p>
            <p class="mt-2 text-xl font-bold">
              <a href={AUTHOR_URL} class="no-underline hover:underline decoration-2 underline-offset-4">{site.author.name}</a>,{' '}
              <span class="font-normal">{site.author.role.toLowerCase()} of {site.name}</span>
            </p>
            {authorBio().map((p) => <p class="mt-3 text-ink-soft">{p}</p>)}
          </aside>
        </div>
        {
          service && (
            <aside class="lg:col-span-4">
              <div class="border border-line bg-white p-6 sm:p-8 lg:sticky lg:top-28">
                <h2 class="text-2xl">Want it done for you?</h2>
                <p class="mt-3 text-ink-soft">{service.data.summary}</p>
                <a href={`/contact/?service=${service.id}`} class="btn btn-primary mt-6 w-full">Get a Free Quote</a>
                <p class="mt-4">
                  <a href={`/services/${service.id}/`} class="link">About our {service.data.shortTitle.toLowerCase()} service</a>
                </p>
              </div>
            </aside>
          )
        }
      </div>
    </section>
  </article>

  {
    data.faqs.length > 0 && (
      <section class="band-white section" aria-labelledby="faq-heading">
        <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
          <h2 id="faq-heading" class="lg:col-span-4">Common questions</h2>
          <div class="lg:col-span-8"><FaqList faqs={data.faqs} /></div>
        </div>
      </section>
    )
  }

  {
    morePosts.length > 0 && (
      <section class="section" aria-labelledby="more-heading">
        <div class="wrap">
          <h2 id="more-heading" class="text-2xl">More from the blog</h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {morePosts.map((p) => (
              <li class="border-t border-line pt-4">
                <h3 class="text-lg">
                  <a href={`/blog/${p.id}/`} class="no-underline hover:underline decoration-2 underline-offset-4">{p.data.title}</a>
                </h3>
                <p class="mt-1 text-ink-soft">{p.data.excerpt}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand service={data.service} />

  {/* Back-to-top button: appears after scrolling down; sits above the phone call/quote bar on small screens. */}
  <a
    href="#top"
    id="back-to-top"
    aria-label="Back to top"
    class="back-to-top fixed right-4 bottom-24 z-30 inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-white text-ink shadow-md no-underline lg:bottom-8"
  >
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
  </a>
</BaseLayout>

<style>
  .back-to-top {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const update = () => btn.classList.toggle('is-visible', window.scrollY > 800);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
