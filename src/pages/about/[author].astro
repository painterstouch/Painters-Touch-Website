---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { getPosts } from '../../lib/data';
import { personSchema } from '../../lib/schema';
import { authorBio, pageTitle } from '../../lib/utils';

// The blog author's page, e.g. /about/ivan/. Edit the details in src/config/site.ts → author.
export function getStaticPaths() {
  return [{ params: { author: site.author.slug } }];
}

const posts = await getPosts();
const bio = authorBio();
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={pageTitle(`${site.author.name}, ${site.author.role}`)}
  description={`Meet ${site.author.name}, ${site.author.role.toLowerCase()} of ${site.name}: ${site.trust.yearsInBusiness} years and ${site.trust.jobsCompleted} painting jobs across NYC and Long Island.`}
  schema={[personSchema()]}
>
  <PageHeader
    title={`${site.author.name}, ${site.author.role.toLowerCase()}`}
    lead={`The painter behind ${site.name}, and the person writing our blog.`}
    crumbs={[
      { name: 'About', href: '/about/' },
      { name: site.author.name, href: `/about/${site.author.slug}/` },
    ]}
  />

  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="prose-site lg:col-span-7">
        {bio.map((p) => <p>{p}</p>)}
        <p>
          Read more about <a href="/about/">how {site.name} works</a>, or see <a href="/work/">our recent projects</a>.
        </p>
      </div>
      <aside class="lg:col-span-5">
        <div class="border border-line bg-white p-6 sm:p-8">
          <h2 class="text-2xl">At a glance</h2>
          <ul class="mt-5 space-y-3">
            <li><strong>{site.trust.yearsInBusiness} years</strong> running {site.name}</li>
            <li><strong>{site.trust.jobsCompleted} jobs</strong> across NYC and Long Island</li>
            <li><strong>Specialties:</strong> {site.author.knowsAbout.join(', ').toLowerCase()}</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="band-white section" aria-labelledby="posts-heading">
        <div class="wrap">
          <h2 id="posts-heading" class="text-2xl">Posts by {site.author.name}</h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-2">
            {posts.map((p) => (
              <li class="border-t border-line pt-4">
                <p class="text-sm text-ink-soft">{dateFmt(p.data.date)}</p>
                <h3 class="mt-1 text-lg">
                  <a href={`/blog/${p.id}/`} class="no-underline hover:underline decoration-2 underline-offset-4">{p.data.title}</a>
                </h3>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
