---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SheenGuide from '../../components/SheenGuide.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { chipAt, getServices } from '../../lib/data';
import { pageTitle } from '../../lib/utils';

const services = await getServices();
---

<BaseLayout
  title={pageTitle('Interior Painting Services in NYC')}
  description="Interior painting, apartment and condo painting, light commercial painting, and drywall patching in NYC. Flat-rate quotes and on-time crews."
>
  <PageHeader
    title="Interior painting services in NYC"
    lead="Walls, ceilings, trim and doors in homes and offices, with the patching and prep that makes the paint last."
    crumbs={[{ name: 'Services', href: '/services/' }]}
  />

  <div class="wrap">
    {
      services.map((service, i) => (
        <section id={service.id} class="grid gap-6 border-b border-line py-9 last:border-b-0 md:grid-cols-12 md:gap-10 md:py-16 sm:gap-8 sm:py-12" style={`--chip:${chipAt(i).hex}`}>
          <div class="flex gap-4 md:col-span-5">
            <span class="chip-bar" aria-hidden="true" />
            <div>
              <h2 class="text-[1.75rem] sm:text-4xl">{service.data.title}</h2>
              <p class="lead mt-3 sm:mt-4">{service.data.summary}</p>
              <a href={`/services/${service.id}/`} class="btn btn-ink mt-5 w-full sm:mt-6 sm:w-auto">
                See {service.data.shortTitle.toLowerCase()}
              </a>
            </div>
          </div>
          {/* Phones show the first five "included" items and skip "Best for" (the service page has everything). */}
          <div class="grid gap-8 sm:grid-cols-2 md:col-span-7">
            <div>
              <h3 class="text-lg">What’s included</h3>
              <ul class="mt-4 space-y-2.5">
                {service.data.includes.map((item, n) => (
                  <li class:list={['flex gap-2.5', n >= 5 && 'max-sm:hidden']}>
                    <Icon name="check" size={18} class="mt-[0.3rem] flex-none text-tape" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            {service.data.bestFor.length > 0 && (
              <div class="max-sm:hidden">
                <h3 class="text-lg">Best for</h3>
                <ul class="mt-4 space-y-2.5">
                  {service.data.bestFor.map((item) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" size={18} class="mt-[0.3rem] flex-none text-tape" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <section class="band-white section" aria-labelledby="sheen-heading">
    <div class="wrap">
      <h2 id="sheen-heading" class="max-w-2xl">Which finish goes where</h2>
      <p class="lead mt-4">Paint comes in different sheens. Glossier paint is tougher and easier to clean, but shows more flaws. Here is how we usually match them to surfaces.</p>
      <div class="mt-10">
        <SheenGuide />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
