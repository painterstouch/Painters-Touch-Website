---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SheenGuide from '../../components/SheenGuide.astro';
import FaqList from '../../components/FaqList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { getAreas, getProjects, getServices } from '../../lib/data';
import { faqSchema, serviceSchema } from '../../lib/schema';
import { pageTitle, phoneHref } from '../../lib/utils';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const [allServices, allAreas, allProjects] = await Promise.all([getServices(), getAreas(), getProjects()]);
const related = data.related.map((id) => allServices.find((s) => s.id === id)).filter((s) => s !== undefined);
const areas = allAreas.filter((a) => a.data.services.includes(service.id));
const projects = allProjects.filter((p) => p.data.service === service.id).slice(0, 3);

const schema: object[] = [serviceSchema(service, areas.map((a) => `${a.data.name}, ${a.data.region}`))];
if (data.faqs.length) schema.push(faqSchema(data.faqs));
---

<BaseLayout title={pageTitle(data.metaTitle)} description={data.metaDescription} {schema}>
  <PageHeader
    title={`${data.title} in NYC`}
    lead={data.lead}
    crumbs={[
      { name: 'Services', href: '/services/' },
      { name: data.title, href: `/services/${service.id}/` },
    ]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`/contact/?service=${service.id}`} class="btn btn-primary">Get a Free Quote</a>
      <a href={phoneHref()} class="btn btn-outline">
        <Icon name="phone" size={20} />
        Call Now
        <span class="sr-only">{site.phone}</span>
      </a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="prose-site lg:col-span-7">
        <Content />
      </div>
      <aside class="lg:col-span-5">
        <div class="border border-line bg-white p-6 sm:p-8 lg:sticky lg:top-28">
          <h2 class="text-2xl">What’s included</h2>
          <ul class="mt-5 space-y-3">
            {
              data.includes.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={18} class="mt-[0.3rem] flex-none text-tape" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          {
            data.bestFor.length > 0 && (
              <>
                <h3 class="mt-8 text-lg">Best for</h3>
                <ul class="mt-4 space-y-2.5 text-ink-soft">
                  {data.bestFor.map((item) => <li>{item}</li>)}
                </ul>
              </>
            )
          }
          <a href={`/contact/?service=${service.id}`} class="btn btn-primary mt-8 w-full">Get a Free Quote</a>
        </div>
      </aside>
    </div>
  </section>

  {
    data.sheenGuide && (
      <section class="band-white section" aria-labelledby="sheen-heading">
        <div class="wrap">
          <h2 id="sheen-heading" class="max-w-2xl">Choosing the right finish</h2>
          <p class="lead mt-4">Glossier paint is tougher and easier to clean, but shows more flaws in the wall. We recommend a finish for each surface when we quote.</p>
          <div class="mt-10"><SheenGuide /></div>
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="section" aria-labelledby="projects-heading">
        <div class="wrap">
          <h2 id="projects-heading" class="max-w-2xl">{data.shortTitle} projects</h2>
          <ul class="mt-8 grid grid-cols-2 gap-x-3 gap-y-7 sm:mt-10 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-3">
            {projects.map((project) => <li><ProjectCard project={project} /></li>)}
          </ul>
          <p class="mt-8"><a href="/work/" class="link hit inline-block">See all our work</a></p>
        </div>
      </section>
    )
  }

  {
    data.faqs.length > 0 && (
      <section class="band-white section" aria-labelledby="faq-heading">
        <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
          <h2 id="faq-heading" class="lg:col-span-4">Common questions about {data.shortTitle.toLowerCase()}</h2>
          <div class="lg:col-span-8"><FaqList faqs={data.faqs} /></div>
        </div>
      </section>
    )
  }

  {
    areas.length > 0 && (
      <section class="section" aria-labelledby="areas-heading">
        <div class="wrap">
          <h2 id="areas-heading" class="max-w-2xl">Where we offer {data.shortTitle.toLowerCase()}</h2>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-0.5 sm:mt-8">
            {areas.map((area) => (
              <li>
                <a href={`/areas/${area.id}/`} class="link inline-flex min-h-11 items-center">{area.data.name}, {area.data.region}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="band-white section-tight" aria-labelledby="related-heading">
        <div class="wrap">
          <h2 id="related-heading" class="text-2xl">Related services</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {related.map((r) => (
              <li class="border-t border-line pt-4">
                <h3 class="text-lg">
                  <a href={`/services/${r.id}/`} class="no-underline hover:underline decoration-2 underline-offset-4">{r.data.title}</a>
                </h3>
                <p class="mt-1 text-ink-soft">{r.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand service={service.id} />
</BaseLayout>
