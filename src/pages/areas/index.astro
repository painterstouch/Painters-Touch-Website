---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AreaList from '../../components/AreaList.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { pageTitle } from '../../lib/utils';
---

<BaseLayout
  title={pageTitle('Painting Service Areas in NYC')}
  description={`Interior painters serving ${site.areaSummary}. Find your neighborhood to see how we work there and get a flat-rate quote.`}
>
  <PageHeader
    title="Interior painting service areas"
    lead={`We paint in ${site.areaSummary}. Choose your neighborhood to see what the work looks like there.`}
    crumbs={[{ name: 'Service Areas', href: '/areas/' }]}
  />

  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Neighborhoods we serve</h2>
      <AreaList />
      <p class="mt-8 max-w-xl text-ink-soft">
        Don’t see your neighborhood? We may still cover it. <a href="/contact/" class="link">Ask us</a> and we’ll tell you
        honestly.
      </p>
    </div>
  </section>

  <section class="band-white section" aria-labelledby="map-heading">
    <div class="wrap">
      <h2 id="map-heading" class="max-w-xl">Where we work</h2>
      <MapEmbed query={site.mapQuery} zoom={site.mapZoom} title="Map of our painting service area in New York and Long Island" class="mt-8" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
