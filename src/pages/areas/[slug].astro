---
import AreaPage from '../../components/AreaPage.astro';
import RegionPage from '../../components/RegionPage.astro';
import { getAreas, getRegions } from '../../lib/data';

/**
 * /areas/<slug>/ serves two kinds of page:
 *  - borough / region pages (src/content/regions), e.g. /areas/queens/
 *  - neighborhood pages (src/content/areas), e.g. /areas/astoria/
 * Their file names must not clash.
 */
export async function getStaticPaths() {
  const [areas, regions] = await Promise.all([getAreas(), getRegions()]);
  const clash = regions.find((r) => areas.some((a) => a.id === r.id));
  if (clash) throw new Error(`"${clash.id}" is both a region page and a neighborhood page. Rename one of the files.`);
  return [
    ...regions.map((region) => ({ params: { slug: region.id }, props: { region } })),
    ...areas.map((area) => ({ params: { slug: area.id }, props: { area } })),
  ];
}

const { area, region } = Astro.props;
---

{region ? <RegionPage region={region} /> : <AreaPage area={area!} />}
