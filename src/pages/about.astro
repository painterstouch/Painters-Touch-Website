---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { chipAt } from '../lib/data';
import { hasPlaceholder, pageTitle } from '../lib/utils';

const standards = [
  {
    title: 'We show up on time',
    text: 'When we say 8:00, we are there at 8:00. If something changes, you hear it from us first.',
  },
  {
    title: 'We protect your home',
    text: 'Furniture is moved to the center of the room and covered. Floors are protected and edges are masked before any paint is opened.',
  },
  {
    title: 'We clean up as we go',
    text: 'Tools and materials are packed away at the end of every day, and the space is left tidy when the job is done.',
  },
  {
    title: 'We price it flat',
    text: 'One written price for the whole job, covering prep, paint and clean-up. No hourly billing and no surprise add-ons.',
  },
  {
    title: 'We prep like it matters',
    text: 'Patching, sanding, caulking and priming come before paint, because that is what makes a finish look sharp and last.',
  },
];

// Team members still showing [PLACEHOLDER] text stay hidden until they are filled in (src/config/site.ts → about.team).
const team = site.about.team.filter((p) => ![p.name, p.role, p.bio].some(hasPlaceholder));
---

<BaseLayout
  title={pageTitle('About Our Painting Company')}
  description={`Meet the team behind ${site.name}, interior painters in NYC. Learn how we work: on time, furniture and floors protected, flat-rate pricing.`}
>
  <PageHeader
    title={`About ${site.name}`}
    lead="Interior painters who show up on time, protect your home and leave the finished work looking sharp."
    crumbs={[{ name: 'About', href: '/about/' }]}
  />

  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <h2 class="lg:col-span-4">Our story</h2>
      <div class="prose-site lg:col-span-8">
        {site.about.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="band-white section" aria-labelledby="standards-heading">
    <div class="wrap">
      <h2 id="standards-heading" class="max-w-xl">How we work</h2>
      <p class="lead mt-4">These are the standards every job is held to.</p>
      <ul class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          standards.map((s, i) => (
            <li class="flex gap-4" style={`--chip:${chipAt(i).hex}`}>
              <span class="chip-bar" aria-hidden="true" />
              <div>
                <h3 class="text-xl">{s.title}</h3>
                <p class="mt-2 max-w-md text-ink-soft">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    team.length > 0 && (
      <section class="section" aria-labelledby="team-heading">
        <div class="wrap">
          <h2 id="team-heading" class="max-w-xl">The team</h2>
          <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
            {team.map((person) => (
              <li class="border-t border-line pt-5">
                <h3 class="text-xl">{person.name}</h3>
                <p class="mt-1 font-semibold text-tape">{person.role}</p>
                <p class="mt-3 text-ink-soft">{person.bio}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand heading="Let’s talk about your project." />
</BaseLayout>
