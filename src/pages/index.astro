---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceRows from '../components/ServiceRows.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ReviewCard from '../components/ReviewCard.astro';
import AreaList from '../components/AreaList.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getFeaturedProjects, getReviews, getServices } from '../lib/data';
import { pageTitle } from '../lib/utils';

const [services, featured, reviews] = await Promise.all([getServices(), getFeaturedProjects(3), getReviews()]);
---

<BaseLayout title={pageTitle('Painters in NYC & Long Island, Flat-Rate Quotes')} description={site.description}>
  <Hero />
  <TrustStrip />

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <h2 id="services-heading" class="max-w-2xl">Interior painting services in NYC</h2>
      <p class="lead mt-4">From a single bedroom to a whole apartment or office, every job starts with careful prep.</p>
      <div class="mt-10">
        <ServiceRows services={services} />
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="band-white section" aria-labelledby="work-heading">
        <div class="wrap">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
              <h2 id="work-heading" class="max-w-xl">Recent work, before and after</h2>
              <p class="lead mt-4">Drag the slider to see what a fresh coat and careful prep can do.</p>
            </div>
            <a href="/work/" class="link hit flex-none self-start sm:self-auto">See all projects</a>
          </div>
          <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-6">
            {featured.map((project) => (
              <li>
                <BeforeAfter
                  before={project.data.before!}
                  after={project.data.after}
                  beforeAlt={project.data.beforeAlt ?? `${project.data.title} before painting`}
                  afterAlt={project.data.afterAlt ?? `${project.data.title} after painting`}
                  sizes="(min-width: 768px) 352px, 100vw"
                  aspect="4 / 5"
                />
                <h3 class="mt-4 text-lg">
                  <a href={`/work/${project.id}/`} class="no-underline hover:underline decoration-2 underline-offset-4">
                    {project.data.title}
                  </a>
                </h3>
                <p class="mt-1 text-sm text-ink-soft">
                  {project.data.location}
                  {project.data.sample && ' (sample project)'}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="reviews-heading">
    <div class="wrap">
      <h2 id="reviews-heading" class="max-w-xl">What our customers say</h2>
      {/* Phones: a swipeable row (the next card peeks in). Larger screens: three cards side by side. */}
      <ul
        class="no-scrollbar -mx-5 mt-8 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-3 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:mt-10 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0"
        tabindex="0"
        aria-label="Customer reviews. Swipe sideways to read more."
      >
        {
          reviews.slice(0, 3).map((review) => (
            <li class="w-[84%] flex-none snap-start sm:w-[60%] md:w-auto">
              <ReviewCard review={review} preview />
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6 md:mt-8">
        {
          site.social.googleReview && (
            <a href={site.social.googleReview} target="_blank" rel="noopener" class="btn btn-ink">
              <Icon name="star" size={18} />
              Review us on Google
            </a>
          )
        }
        <a href="/reviews/" class="link hit inline-block self-start">Read all reviews</a>
      </div>
    </div>
  </section>

  <section class="band-white section" aria-labelledby="areas-heading">
    <div class="wrap">
      <h2 id="areas-heading" class="max-w-2xl">Where we paint</h2>
      <p class="lead mt-4">
        We paint in {site.areaSummary}. Pick your neighborhood to see how we work there. Not on the list? Ask us, we may still cover you.
      </p>
      <div class="mt-10">
        <AreaList compact />
      </div>
      <p class="mt-6"><a href="/areas/" class="link hit inline-block">View all service areas</a></p>
    </div>
  </section>

  <HowItWorks />
  <CtaBand />
</BaseLayout>
